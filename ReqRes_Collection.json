        {
          "name": "02_Create_User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Name matches CSV data\", function () {\r",
                  "    pm.expect(response.name).to.eql(\r",
                  "        pm.iterationData.get(\"name\")\r",
                  "    );\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Job matches CSV data\", function () {\r",
                  "    pm.expect(response.job).to.eql(\r",
                  "        pm.iterationData.get(\"job\")\r",
                  "    );\r",
                  "});\r",
                  "\r",
                  "if (response.id !== undefined) {\r",
                  "    pm.environment.set(\"userId\", response.id);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
